<Window x:Class="Insightful.View.PackageCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Insightful.View"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="PackageCreatorWindow" Height="Auto" Width="600">
    <Window.Resources>
        <SolidColorBrush x:Key="GlassBackground" Color="#AA202020"/>
        <SolidColorBrush x:Key="BorderHighlight" Color="#44FFFFFF"/>
        <Style x:Key="CreatorSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NoteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#11FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource GlassBackground}"
    CornerRadius="16"
    BorderBrush="{StaticResource BorderHighlight}"
    BorderThickness="1"
    Padding="20"
    MinWidth="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Package Creator" FontSize="24" FontWeight="Bold" Foreground="White" Margin="10,0,10,5"/>
                <TextBlock Text="Create and manage your packages easily." FontSize="14" Foreground="White" Margin="10,0,10,20"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.45*"/>
                    <ColumnDefinition Width="0.05*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Package Details" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10,10,10,10"/>
                    <TextBlock Text="Package Name:" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="10,0,10,5"/>
                    <TextBlock Text="App Name:" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="10,0,10,5"/>
                    <TextBlock Text="App Source:" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="10,0,10,5"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBox Name="PackageNameTextBox" Style="{DynamicResource TextBoxGlass}" Margin="5,0,5,5" Height="20"/>
                    <TextBox Name="AppNameTextBox" Style="{DynamicResource TextBoxGlass}" Margin="5,0,5,5" Height="20"/>
                    <Button Name="AppSearchButton" Style="{StaticResource SecondaryGlassButton}" Content="Search" Margin="5,0,5,5" Height="20" Click="Button_SearchApp_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <materialIcons:MaterialIcon Kind="QuestionMarkBox" Width="20" Height="20" Foreground="#EEEEEE" Margin="5,0,5,5" ToolTip="Enter the name of the package."/>
                    <materialIcons:MaterialIcon Kind="QuestionMarkBox" Width="20" Height="20" Foreground="#EEEEEE" Margin="5,0,5,5" ToolTip="Enter the name of the application."/>
                    <materialIcons:MaterialIcon Kind="QuestionMarkBox" Width="20" Height="20" Foreground="#EEEEEE" Margin="5,0,5,5" ToolTip="Enter the source path of the application."/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="App Shortcuts" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10,20,10,5"/>
                <StackPanel Grid.Row="1" Name="ShortcutSectionsPanel">
                    <Border Style="{StaticResource NoteCardStyle}" Margin="10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="10,0,10,5">
                                <TextBlock Text="Shortcut Name:" FontSize="16" FontWeight="Light" Foreground="White"/>
                                <TextBox Name="ShortcutNameTextBox" Style="{DynamicResource TextBoxGlass}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,10,5">
                                <TextBlock Text="Shortcut Key Combination:" FontSize="16" FontWeight="Light" Foreground="White"/>
                                <TextBox Name="ShortcutKeyCombinationTextBox" Style="{DynamicResource TextBoxGlass}"/>
                            </StackPanel>
                            <Button Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource SecondaryGlassButton}"
                                    Content="Remove"
                                    Height="22"
                                    Width="90"
                                    HorizontalAlignment="Right"
                                    Margin="10,8,10,0"
                                    Click="Button_RemoveShortcut_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource GlassButton}" Content="New Shortcut" Height="25" Width="120" HorizontalAlignment="Center" Click="Button_NewShortcut_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="App Notes" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10,20,10,5"/>
                <StackPanel Grid.Row="1" Name="NoteSectionsPanel">
                    <Border Style="{StaticResource NoteCardStyle}" Margin="10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="10,0,10,5">
                                <TextBlock Text="Note Title:" FontSize="16" FontWeight="Light" Foreground="White"/>
                                <TextBox Name="NoteTitleTextBox" Style="{DynamicResource TextBoxGlass}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,10,5">
                                <TextBlock Text="Note Content:" FontSize="16" FontWeight="Light" Foreground="White"/>
                                <TextBox Name="NoteContentTextBox" Style="{DynamicResource TextBoxGlass}"/>
                            </StackPanel>
                            <Button Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource SecondaryGlassButton}"
                                    Content="Remove"
                                    Height="22"
                                    Width="90"
                                    HorizontalAlignment="Right"
                                    Margin="10,8,10,0"
                                    Click="Button_RemoveNote_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource GlassButton}" Content="New Note" Height="25" Width="120" HorizontalAlignment="Center" Click="Button_NewNote_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" Margin="10,20,0,0">
                    <Button Style="{StaticResource GlassButton}" Width="32" Height="32" Click="Button_Click">
                        <materialIcons:MaterialIcon Kind="Help"/>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,20,10,0">
                    <Button Style="{StaticResource SecondaryGlassButton}" Content="Import Package" Height="30" Width="120" Margin="0,0,10,0" Click="Button_ImportPackage_Click"/>
                    <Button Style="{StaticResource SecondaryGlassButton}" Content="Merge Packages" Height="30" Width="120" Margin="0,0,10,0" Click="Button_MergePackages_Click"/>
                    <Button Style="{StaticResource GlassButton}" Content="Create Package" Height="30" Width="120" Click="Button_CreatePackage_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
