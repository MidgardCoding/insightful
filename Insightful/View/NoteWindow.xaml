<Window x:Class="Insightful.View.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Insightful.View" xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF" xmlns:viewmodel="clr-namespace:Insightful.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MainWindowViewModel}"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        Title="NoteWindow" Height="450" Width="450">
    <Window.Resources>
        <SolidColorBrush x:Key="GlassBackground" Color="#AA202020"/>
        <SolidColorBrush x:Key="BorderHighlight" Color="#44FFFFFF"/>
        <Style x:Key="ShortcutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NoteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#11FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource GlassBackground}"
        CornerRadius="16"
        BorderBrush="{StaticResource BorderHighlight}"
        BorderThickness="1"
        Padding="20"
        MinWidth="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding CurrentWindowData.AppTitle, FallbackValue='Notes'}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Check out your saved notes about this app. You can edit them at any time in the Package Creator." Foreground="AliceBlue" TextWrapping="Wrap" Margin="10"/>
                <Border Style="{StaticResource NoteCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ItemsControl ItemsSource="{Binding CurrentWindowData.AppNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border Margin="0,5,5,5" Padding="10">
                                            <Grid Width="Auto" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding NoteTitle}" FontSize="14" FontWeight="DemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" Text="{Binding NoteContent}" FontSize="12" Foreground="#5BFFFFFF" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        <Rectangle Grid.Row="1" Height="1" Fill="#22FFFFFF"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Add more notes via the Package Creator" FontSize="10" FontWeight="ExtraLight" Foreground="#22FFFFFF" HorizontalAlignment="Center" Margin="4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <Button Style="{DynamicResource GlassButton}" Grid.Row="2" Content="Close" HorizontalAlignment="Right" Width="75" Height="25" Margin="0,10,0,0" Click="Button_Click"/>
        </Grid>
    </Border>
</Window>
