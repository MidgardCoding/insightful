<Window x:Class="Insightful.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Insightful.View"
        mc:Ignorable="d" WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Title="SettingsWindow" Height="450" Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="GlassBackground" Color="#AA202020"/>
        <SolidColorBrush x:Key="BorderHighlight" Color="#44FFFFFF"/>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource GlassBackground}"
        CornerRadius="16"
        BorderBrush="{StaticResource BorderHighlight}"
        BorderThickness="1"
        Padding="20">
        <Grid>
        
        </Grid>
    </Border>
</Window>
