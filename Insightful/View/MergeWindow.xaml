<Window x:Class="Insightful.View.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:Insightful.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodel:MergeWindowViewModel}"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="Merge packages" Width="600">
    <Window.Resources>
        <SolidColorBrush x:Key="GlassBackground" Color="#AA202020"/>
        <SolidColorBrush x:Key="BorderHighlight" Color="#44FFFFFF"/>
        <Style x:Key="ShortcutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NoteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#11FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource GlassBackground}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderHighlight}"
            BorderThickness="1"
            Padding="20"
            MinWidth="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Merge Packages" Grid.Row="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="10,5,10,0"/>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="Add .json or .insight files, pick a package, then merge its apps into the main Insight Package."
                           Foreground="AliceBlue" TextWrapping="Wrap" Margin="10,0,10,8"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,10,8">
                    <Button Style="{StaticResource SecondaryGlassButton}" Content="Add files…" Margin="0,0,8,0" Padding="12,6"
                            Command="{Binding AddFilesCommand}"/>
                    <Button Style="{StaticResource GlassButton}" Content="Merge" Padding="12,6"
                            Command="{Binding MergeCommand}"/>
                </StackPanel>
                <Border Style="{StaticResource NoteCardStyle}" Padding="8" Margin="10,0,10,0">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding ImportPackages}"
                                 SelectedItem="{Binding SelectedImportPackage, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ShortcutCardStyle}" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                                            <TextBlock Text="{Binding FileLabel}" FontSize="11" Foreground="#BBFFFFFF" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding AppsSummary}" FontSize="11" Foreground="#99FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="Applications currently in the main Insight Package (select to remove)"
                           Foreground="AliceBlue" TextWrapping="Wrap" Margin="10,0,10,8"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,10,8" HorizontalAlignment="Left">
                    <Button Style="{StaticResource SecondaryGlassButton}" Content="Remove selected…" Padding="12,6"
                            Command="{Binding RemoveSelectedAppsCommand}"/>
                </StackPanel>
                <Border Style="{StaticResource NoteCardStyle}" Padding="8" Margin="10,0,10,0">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MainApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ShortcutCardStyle}" Margin="0,0,0,6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                      Foreground="White"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding AppTitle}" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AppSrcDisplay}" FontSize="11" Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource SecondaryGlassButton}" Content="Help" Margin="5" Padding="10,5"
                            Command="{Binding HelpCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GlassButton}" Content="Save" Margin="5" Padding="10,5"
                            Command="{Binding SaveCommand}"/>
                    <Button Style="{StaticResource GlassButton}" Content="Save And Close" Margin="5" Padding="10,5"
                            Command="{Binding SaveAndCloseCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
