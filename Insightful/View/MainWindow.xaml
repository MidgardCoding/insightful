        Height="200" Width="300">
    <Window.Resources>
        <SolidColorBrush x:Key="GlassBackground" Color="#AA202020"/>
        <SolidColorBrush x:Key="BorderHighlight" Color="#44FFFFFF"/>
        <Style x:Key="ShortcutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NoteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#11FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource GlassBackground}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderHighlight}"
            BorderThickness="1"
            Padding="20"
            MinWidth="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CurrentWindowData.AppTitle}" Grid.Column="0" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Border Name="SettingsBorder" Grid.Column="1" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" MouseEnter="SettingsBorder_MouseEnter" MouseLeave="SettingsBorder_MouseLeave" MouseDown="SettingsBorder_MouseDown">
                    <materialIcons:MaterialIcon x:Name="SettingsButton" Kind="Settings" Width="16" Height="16" Foreground="#EEEEEE"/>
                </Border>
            </Grid>
            <StackPanel Grid.Row="1">
                <ItemsControl ItemsSource="{Binding CurrentWindowData.Shortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ShortcutCardStyle}" Margin="0,4,0,4" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="White" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding KeyCombination}" Grid.Column="1" FontSize="12" Foreground="#AAFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Border Style="{StaticResource NoteCardStyle}" Width="258">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ItemsControl ItemsSource="{Binding CurrentWindowData.AppNotes}" MouseDown="Border_MouseDown">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border Margin="0,5,5,5" Padding="10">
                                            <Grid Width="Auto" Height="20" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <TextBlock Text="{Binding NoteTitle}" FontSize="14" FontWeight="Light" Foreground="#CCFFFFFF" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Grid.Column="1">
                                                    <Border Background="#22FFFFFF" Padding="4" CornerRadius="4">
                                                        <materialIcons:MaterialIcon Kind="ExternalLink" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Rectangle Grid.Row="1" Height="1" Fill="#22FFFFFF"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{Binding NoteAvailability}" FontSize="10" FontWeight="ExtraLight" Foreground="#5BFFFFFF" HorizontalAlignment="Center" Margin="4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
