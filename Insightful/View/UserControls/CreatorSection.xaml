<UserControl x:Class="Insightful.View.UserControls.CreatorSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Insightful.View.UserControls" xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="GlassBackground" Color="#AA202020"/>
        <SolidColorBrush x:Key="BorderHighlight" Color="#44FFFFFF"/>
        <Style x:Key="CreatorSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title, FallbackValue='Creator Section'}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Top"/>
        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#99FFFFFF" StrokeThickness="1" Margin="10,40,10,0" VerticalAlignment="Top"/>
        <Border Style="{StaticResource CreatorSectionStyle}" Grid.Row="1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Kind="{Binding IconKind, FallbackValue=Settings}" Width="32" Height="32" Foreground="#EEEEEE" VerticalAlignment="Top" Margin="7"/>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SettingTitle, FallbackValue='Setting Title'}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding SettingDescription, FallbackValue='This is a description of the setting. It provides more details about what this setting does and how to use it.'}" Foreground="AliceBlue" TextWrapping="Wrap" Margin="10,4,10,10" Grid.Row="1"/>
                </Grid>
                <CheckBox Grid.Column="2" VerticalAlignment="Top" Margin="0,16,0,0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
